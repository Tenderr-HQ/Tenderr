# unheard — monorepo root .gitignore
# This file catches editor/OS junk and root-level secrets.
# App-specific ignores live in backend/.gitignore and
# frontend/.gitignore.


# ---- OS junk ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ---- Root-level env files (the real .env.local.* are app-scoped) ----
.env
.env.local
.env.*.local
*.env

# ---- Logs at root ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Coverage reports that live at root ----
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/